# Copy to .env. Never commit .env.
ES_URL=http://127.0.0.1:9200
ES_INDEX_ALIAS=finsearch
ES_INDEX_VERSION=v1
ES_QUERIES_INDEX=finsearch-queries
KIBANA_URL=http://127.0.0.1:5601

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-base

# extractive (default, no LLM) | ollama | gemini | groq | anthropic
LLM_PROVIDER=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
# RAG: min. share of question terms that must occur in the retrieved chunks (0 = gate off)
RAG_MIN_COVERAGE=0.7
RAG_MIN_BM25=26.0
LLM_MAX_RETRIES=2

# Log the raw query text to the observability index (default: only a hash)
LOG_RAW_QUERIES=false
INGEST_USER_AGENT=FinSearch-Portfolio/0.1 (research; contact: set-your-email)

# API: allowed CORS origins (comma-separated, wildcard is ignored) and a light per-IP rate limit
API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
API_RATE_LIMIT=60
API_RATE_WINDOW_S=60
